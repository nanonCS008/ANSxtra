# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Resend (for emails) — https://resend.com/api-keys (value must start with re_)
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Optional: direct https URL to your logo (PNG recommended for email clients). Use this if `/ansxtra-logo.png` is not deployed on your site yet.
# EMAIL_BRAND_LOGO_URL=https://your-cdn.com/ansxtra-logo.png
# Public site origin (https, no trailing slash). Required for embedded logo URL, /my-applications link in emails, etc.
# NEXT_PUBLIC_SITE_URL=https://ansxtra.com
# Optional. If unset, the app uses ANSxtra <onboarding@resend.dev> (Resend test sender; fine for dev).
# Production: verify your domain in Resend, then set e.g. ANSxtra <noreply@ansxtra.com>.
# If Vercel still has an old RESEND_FROM=noreply@ansxtra.com and the domain is not verified, remove that var or use onboarding@resend.dev until DNS is verified.
RESEND_FROM=
#
# Feedback form in approval emails uses https://forms.gle/cSos2G3GkmCEuq7G8 by default.
# Set only if you need a different form: ANSXTRA_FEEDBACK_FORM_URL=https://...
#
# Application period admin digests (not per-application spam)
# When APPLICATION_PERIOD_END_ISO has passed (per server UTC), cron calls
# `/api/cron/application-period-summary` which emails ADMIN_EMAILS once per digest key.
# Example (ICT): 2026-05-22T23:59:59+07:00
# APPLICATION_PERIOD_END_ISO=
#
# Milestone thresholds for total rows in applications_v2 (comma-separated ascending).
# Default if unset: 100,200,300,400,500,750,1000
# APPLICATION_COUNT_MILESTONES=100,200,300
#
# Secret for cron: send header Authorization: Bearer <CRON_SECRET> (set in Vercel env + Cron job auth).
CRON_SECRET=YOUR_CRON_SECRET

ADMIN_EMAILS=nanon.jirapong@amnuaysilpa.ac.th,chinthakag@amnuaysilpa.ac.th,79528@student.amnuaysilpa.ac.th,79599@student.amnuaysilpa.ac.th,79592@student.amnuaysilpa.ac.th
