# Resend (for emails) — https://resend.com/api-keys (value must start with re_)
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Optional: full https URL to a public image used inside HTML emails (approval, etc.). If unset, uses NEXT_PUBLIC_SITE_URL + /ansxtra-logo.png, or Vercel URL + /ansxtra-logo.png.
# EMAIL_BRAND_LOGO_URL=https://ansxtra.com/ansxtra-logo.png
# Public site origin (https) so approval emails can embed the logo; set in production to your real domain.
# NEXT_PUBLIC_SITE_URL=https://ansxtra.com
# Optional. If unset, the app uses ANSxtra <onboarding@resend.dev> (Resend test sender; fine for dev).
# Production: verify your domain in Resend, then set e.g. ANSxtra <noreply@ansxtra.com>.
# If Vercel still has an old RESEND_FROM=noreply@ansxtra.com and the domain is not verified, remove that var or use onboarding@resend.dev until DNS is verified.
RESEND_FROM=
#
# When approving/denying applications, also send an "admin copy" email to every address in ADMIN_EMAILS.
# Default: false (only the student gets an email).
